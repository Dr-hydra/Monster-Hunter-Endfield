* text=auto eol=lf
*.md text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
# Unified patches require a leading space on empty context lines.
*.patch text eol=lf whitespace=-blank-at-eol
